# Required — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required — get your key at https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# Required — get your key at https://www.mysportsfeeds.com
MSF_API_KEY=your_mysportsfeeds_api_key_here
# MSF_PASSWORD=MYSPORTSFEEDS   # default password — only change if MSF gave you a custom one

# Path to Railway volume mount point (set in Railway dashboard as a variable)
# CACHE_DIR=/app/data

# Set to production when deploying (Railway sets this automatically if you add it as a variable)
NODE_ENV=development

# Port (Railway sets this automatically; defaults to 3001 locally)
# PORT=3001
